# Copy to .env (gitignored). Scripts and tests read this file; nothing here is ever committed.
# Local development (npm run dev:server): any random strings work as keys.
APP_ID=game-backend-starter-local
JS_KEY=replace-with-a-random-string
REST_KEY=replace-with-a-random-string
MASTER_KEY=replace-with-a-random-string        # local dev server only. Back4app: leave EMPTY — setup/seed/bench/tests
                                                # then run through the Cloud Code setup helpers (SETUP_ENABLED in cloud/config.js)
SERVER_URL=http://localhost:1337/parse          # Back4app: https://parseapi.back4app.com
DATABASE_URL=postgres://localhost:5433/game_dev # local parse-server only; ignored for Back4app
PARSE_PORT=1337
# Back4app: APP_ID / JS_KEY / REST_KEY from App Settings → Security & Keys; the master key stays in the dashboard.
# TEST_SERVER_URL=https://parseapi.back4app.com (environment, not here) points `npm test` at a staging app without the key.
